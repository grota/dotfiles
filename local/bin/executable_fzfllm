#!/usr/bin/env bash

FZFLLM=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)/$(basename -- "${BASH_SOURCE[0]}")
FZF_MARKDOWN_PREVIEW_COMMAND="${FZF_MARKDOWN_PREVIEW_COMMAND:-gomd -r}"
# shellcheck source=dot_local/grota/scripts/fzf-scripts-utils.sh
source "$HOME/.local/grota/scripts/fzf-scripts-utils.sh"

LLM_GET_THREAD_CMD="${LLM_GET_THREAD_CMD:-llm logs list --cid {1}}"
LLM_OPEN_IN_PAGER_CMD="${LLM_OPEN_IN_PAGER_CMD:-gomd}"
# LLM_OPEN_IN_PAGER_CMD="${LLM_OPEN_IN_PAGER_CMD:-bat --language markdown --color always --paging=always --plain --pager=\"less -R -+S --wordwrap\"}"

KEY_NEW_THREAD="${KEY_NEW_THREAD:-ctrl-t}"
KEY_SEARCH_THREADS="${KEY_SEARCH_THREADS:-ctrl-/}"
KEY_DELETE="${KEY_DELETE:-ctrl-delete}"
KEY_OPEN_IN_PAGER="${KEY_OPEN_IN_PAGER:-enter}"
KEY_OPEN_IN_EDITOR="${KEY_OPEN_IN_EDITOR:-alt-enter}"
KEY_CONTINUE_THREAD="${KEY_CONTINUE_THREAD:-ctrl-o}"
KEY_RENAME_THREAD="${KEY_RENAME_THREAD:-ctrl-r}"
KEY_EDIT_THREAD_MESSAGES="${KEY_EDIT_THREAD_MESSAGES:-alt-e}"
KEY_CLEAN_FRAGMENTS="${KEY_CLEAN_FRAGMENTS:-alt-f}"

HEADER_TEXT="Press $KEY_SHOW_HELP for help"

FZFLIB_FIFO=$(mktemp -u "fzfllm_fifo_XXXX.md" --tmpdir)
mkfifo "$FZFLIB_FIFO"

function cleanup {
  rm -f "$FZFLIB_FIFO"
}

trap cleanup EXIT

# We assume NUL-terminated input to fzf to accomodate multiline input.
# See https://junegunn.github.io/fzf/tips/processing-multi-line-items/
# Input to fzf is assumed to be tab delimited, with the thread id in
# the first field and text in the second.
FZFLLM_FZF_GENERAL_OPTS="
$(_fzflib_graphical_opts "$HEADER_TEXT" "$FZFLLM help")
--ansi --no-multi --no-select-1
--nth=1 --with-nth=2 --delimiter='\x1F' --read0 --highlight-line
$FZFLLM_FZF_GENERAL_OPTS"

# We prefer the pattern transform[echo print:SUBCOMMAND \"{1}\"]+accept
# instead of execute($FZFLLM SUBCOMMAND {1})+print(list_threads)+accept
# because with execute the spawned process will inherit the environment
# and inheriting FZF_DEFAULT_OPTS is a problem (duplicates).
FZFLLM_BINDS_FOR_LIST_OF_THREADS="
--preview='$LLM_GET_THREAD_CMD | $FZF_MARKDOWN_PREVIEW_COMMAND'
--bind='$KEY_OPEN_IN_PAGER:execute($LLM_GET_THREAD_CMD | $LLM_OPEN_IN_PAGER_CMD)'
--bind='$KEY_DELETE:transform[echo print:delete_thread {1}]+accept'
--bind='$KEY_OPEN_IN_EDITOR:execute($LLM_GET_THREAD_CMD | $FZFLLM open_stdin_in_editor)'
--bind='$KEY_NEW_THREAD:print(new_thread)+accept'
--bind='$KEY_CONTINUE_THREAD:transform[echo print:continue_thread {1}]+accept'
--bind='$KEY_SEARCH_THREADS:transform[echo print:search_threads \"{fzf:query}\"]+accept'
--bind='$KEY_RENAME_THREAD:transform[echo print:rename_thread {1} {2}]+accept'
--bind='$KEY_EDIT_THREAD_MESSAGES:transform[echo print:edit_thread_messages {1}]+accept'
--bind='$KEY_CLEAN_FRAGMENTS:transform[echo print:clean_fragments]+accept'
"

_fzfllm_main() {
  local NEXT_COMMAND=list_threads
  local NEXT_COMMAND_PARAMS=
  local PREVIOUS_COMMAND=
  while true; do
    PREVIOUS_COMMAND="$NEXT_COMMAND"
    # shellcheck disable=SC2086
    IFS=' ' read -r NEXT_COMMAND NEXT_COMMAND_PARAMS < <($FZFLLM "$NEXT_COMMAND" $NEXT_COMMAND_PARAMS)
    # For debug:
    # echo in main loop parsed: NEXT_COMMAND is "|$NEXT_COMMAND|" and NEXT_COMMAND_PARAMS is "|$NEXT_COMMAND_PARAMS|" 1>&2
    # sleep 1
    if [ -z "$NEXT_COMMAND" ] && [ "$PREVIOUS_COMMAND" == list_threads ]; then
      return
    fi
    if [ -z "$NEXT_COMMAND" ]; then
      NEXT_COMMAND=list_threads
    fi
    if [ "$NEXT_COMMAND" == exitfzfllm ]; then
      return
    fi done
}

_fzfllm_list_threads() {
  local OPTS="
  $FZF_DEFAULT_OPTS
  $FZFLLM_FZF_GENERAL_OPTS
  $FZFLLM_BINDS_FOR_LIST_OF_THREADS
  --prompt=\"🧵llm chats\> \"
  --pointer='👉'
  $FZFLLM_LIST_THREADS_FZF_OPTS"

  local THREADS_QUERY
  if _fzfllm_has_new_schema; then
    # New-generation threads (threads/turns) plus legacy conversations
    # (conversations/responses), deduped by id with the new-generation row
    # winning, ordered by most recent activity. Thread ids and conversation
    # ids are both ULIDs in the same space, so they merge cleanly.
    THREADS_QUERY="
    SELECT id, name FROM (
      SELECT threads.id, threads.name, MAX(turns.datetime_utc) AS last_used
      FROM threads
      INNER JOIN turns on turns.thread_id=threads.id
      GROUP BY threads.id
      UNION ALL
      SELECT conversations.id, conversations.name, MAX(responses.datetime_utc)
      FROM conversations
      INNER JOIN responses on conversations.id=responses.conversation_id
      WHERE conversations.id NOT IN (SELECT id FROM threads)
      GROUP BY conversations.id
    )
    GROUP BY id
    ORDER BY last_used DESC"
  else
    # Installed llm predates 0.32: only the legacy tables exist.
    THREADS_QUERY="
    SELECT conversations.id, conversations.name
    FROM conversations
    INNER JOIN responses on conversations.id=responses.conversation_id
    GROUP BY conversations.id
    ORDER BY responses.datetime_utc DESC"
  fi
  _fzfllm_execute_query "$THREADS_QUERY" | FZF_DEFAULT_OPTS="$OPTS" fzf
}

_fzfllm_search_threads() {
  local OPTS="
  $FZF_DEFAULT_OPTS
  $FZFLLM_FZF_GENERAL_OPTS
  $FZFLLM_BINDS_FOR_LIST_OF_THREADS
  --prompt=\"results\> \"
  --pointer='👉'
  $FZFLLM_SEARCH_THREADS_FZF_OPTS"

  # The fzf bind passes the query wrapped in double quotes; strip those and
  # single-quote-escape the term for SQL. (The old `match $*` form relied on
  # SQLite's double-quoted-string fallback, which newer sqlite3 rejects.)
  local Q="$*"
  Q="${Q#\"}"
  Q="${Q%\"}"
  Q="${Q//\'/\'\'}"

  local SEARCH_QUERY
  if _fzfllm_has_new_schema; then
    # FTS5 search over both generations: turn_search_fts for the new
    # content-addressed tables, responses_fts for legacy history. Same
    # bm25() prompt/response weights llm itself uses; the legacy branch
    # excludes ids that are already turns (dual-write-era dedup). The
    # two bm25 scores come from separate indexes, so they are carried as
    # a rank column and sorted together, like merged_log_rows does.
    SEARCH_QUERY="
    SELECT id, name FROM (
      SELECT threads.id, threads.name, bm25(turn_search_fts, 10.0, 1.0) AS rank
        FROM turn_search
        JOIN turn_search_fts ON turn_search_fts.rowid = turn_search.id
        JOIN turns ON turns.id = turn_search.turn_id
        JOIN threads ON threads.id = turns.thread_id
        WHERE turn_search_fts match '$Q'
      UNION ALL
      SELECT conversations.id, conversations.name, bm25(responses_fts, 10.0, 1.0)
        FROM responses
        LEFT JOIN conversations ON responses.conversation_id = conversations.id
        JOIN responses_fts ON responses_fts.rowid = responses.rowid
        WHERE responses_fts match '$Q'
        AND responses.id NOT IN (SELECT id FROM turns)
    )
    ORDER BY rank"
  else
    SEARCH_QUERY="
    SELECT conversations.id, conversations.name
      FROM responses
      LEFT JOIN conversations ON responses.conversation_id = conversations.id
      JOIN responses_fts ON responses_fts.rowid = responses.rowid
      WHERE responses_fts match '$Q'
      ORDER BY responses_fts.rank DESC"
  fi
  local SEARCH_RESULTS
  # Here we do no care much about keeping newlines from the results because
  # we fetch conversations.name. Also command substitution would strip the null
  # byte so we need to transform it back to a normal newline.
  SEARCH_RESULTS=$(_fzfllm_execute_query "$SEARCH_QUERY" | tr '\0' '\n')
  if [ -z "${SEARCH_RESULTS}" ]; then
    read -e -r -p "No results found."
    return
  fi
  echo -E "$SEARCH_RESULTS" | tr $'\n' '\0' | FZF_DEFAULT_OPTS="$OPTS" fzf
}

_fzfllm_edit_thread_messages() {
  local OPTS="
  $FZF_DEFAULT_OPTS
  $FZFLLM_FZF_GENERAL_OPTS
  --preview='$FZFLLM preview_message {1} | $FZF_MARKDOWN_PREVIEW_COMMAND'
  --prompt=\"🗨  messages\> \"
  --bind='$KEY_DELETE:transform[echo print:delete_message {1}]+accept'
  --bind='$KEY_OPEN_IN_PAGER:execute($FZFLLM preview_message {1} | $LLM_OPEN_IN_PAGER_CMD)'
  --bind='$KEY_OPEN_IN_EDITOR:execute($FZFLLM preview_message {1} | $FZFLLM open_stdin_in_editor)'
  $FZFLLM_EDIT_THREAD_MESSAGES_FZF_OPTS"

  if _fzfllm_has_new_schema; then
    # New turns and legacy responses for this thread, deduped (turn wins),
    # chronological. The prompt text comes from turn_search for new turns
    # (the plain typed prompt, fragments excluded) and responses.prompt
    # for legacy rows. Emitted ids are understood by preview_message.
    _fzfllm_execute_query "
    SELECT id, substr(prompt, 0, 1000) FROM (
      SELECT turns.id AS id,
             coalesce(turn_search.prompt, '') AS prompt,
             turns.datetime_utc AS ts
      FROM turns
      LEFT JOIN turn_search ON turn_search.turn_id = turns.id
      WHERE turns.thread_id = '$1'
      UNION ALL
      SELECT responses.id, responses.prompt, responses.datetime_utc
      FROM responses
      WHERE responses.conversation_id = '$1'
      AND responses.id NOT IN (SELECT id FROM turns)
    ) ORDER BY ts ASC
    " | FZF_DEFAULT_OPTS="$OPTS" fzf
  else
    _fzfllm_execute_query "
    SELECT id, substring(prompt, 0, 1000) from responses where conversation_id='$1'
    ORDER BY datetime_utc ASC
    " | FZF_DEFAULT_OPTS="$OPTS" fzf
  fi
}

_fzfllm_preview_message() {
  local sections
  if _fzfllm_has_new_schema; then
    # $1 may be a new-schema turn id or a legacy response id. Try the new
    # content-addressed tables first (prompt/response from turn_search),
    # then fall back to the legacy responses row.
    IFS=$'\x1f' read -r -d '' -a sections < <(_fzfllm_execute_query "
    SELECT turn_search.prompt, turn_search.response, turns.datetime_utc
    FROM turns
    LEFT JOIN turn_search ON turn_search.turn_id = turns.id
    WHERE turns.id = '$1'")
    if [ ${#sections[@]} -eq 0 ]; then
      IFS=$'\x1f' read -r -d '' -a sections < <(_fzfllm_execute_query "SELECT prompt, response, datetime_utc from responses where id='$1'")
    fi
  else
    IFS=$'\x1f' read -r -d '' -a sections < <(_fzfllm_execute_query "SELECT prompt, response, datetime_utc from responses where id='$1'")
  fi
  echo "# Message from ${sections[2]:0:19}"
  echo
  echo "## 🧑 Prompt:"
  echo
  echo "${sections[0]}"
  echo
  echo "## 🤖 Response:"
  echo
  echo "${sections[1]}"
}

_fzfllm_delete_thread() {
  if _fzfllm_has_new_schema; then
    # Remove the thread's turns (children first) and the thread row, plus
    # the legacy responses/conversations rows. Message and part rows are
    # deliberately left behind: since 0.32 messages are content-addressed
    # and shared between threads, LLM never garbage-collects them.
    _fzfllm_execute_query "
    DELETE FROM turn_search WHERE turn_id IN (SELECT id FROM turns WHERE thread_id = '${1}');
    DELETE FROM turn_tools WHERE turn_id IN (SELECT id FROM turns WHERE thread_id = '${1}');
    DELETE FROM turn_fragments WHERE turn_id IN (SELECT id FROM turns WHERE thread_id = '${1}');
    DELETE FROM tool_instantiations WHERE turn_id IN (SELECT id FROM turns WHERE thread_id = '${1}');
    DELETE FROM turns WHERE thread_id = '${1}';
    DELETE FROM threads WHERE id = '${1}';
    DELETE FROM responses WHERE conversation_id = '${1}';
    DELETE FROM conversations WHERE id = '${1}';"
  else
    _fzfllm_execute_query "
    DELETE FROM responses WHERE conversation_id = '${1}';
    DELETE FROM conversations WHERE id = '${1}';"
  fi
}

_fzfllm_delete_message() {
  local cid remaining_messages
  if _fzfllm_has_new_schema; then
    # $1 may be a new-schema turn id or a legacy response id.
    cid=$(_fzfllm_execute_query "SELECT thread_id FROM turns WHERE id = '${1}'" | tr '\0' '\n')
    if [ -z "$cid" ]; then
      cid=$(_fzfllm_execute_query "SELECT conversation_id FROM responses WHERE id = '${1}'" | tr '\0' '\n')
    fi
    _fzfllm_execute_query "
    DELETE FROM turn_search WHERE turn_id = '${1}';
    DELETE FROM turn_tools WHERE turn_id = '${1}';
    DELETE FROM turn_fragments WHERE turn_id = '${1}';
    DELETE FROM tool_instantiations WHERE turn_id = '${1}';
    DELETE FROM turns WHERE id = '${1}';
    DELETE FROM responses WHERE id = '${1}';"
    remaining_messages=$(_fzfllm_execute_query "
    SELECT (SELECT count(*) FROM turns WHERE thread_id = '${cid}')
         + (SELECT count(*) FROM responses WHERE conversation_id = '${cid}' AND id NOT IN (SELECT id FROM turns))" | tr '\0' '\n')
  else
    cid=$(_fzfllm_execute_query "SELECT conversation_id FROM responses WHERE id = '${1}'" | tr '\0' '\n')
    _fzfllm_execute_query "DELETE FROM responses WHERE id = '${1}';"
    remaining_messages=$(_fzfllm_execute_query "SELECT count(*) FROM responses WHERE conversation_id = '${cid}'" | tr '\0' '\n')
  fi
  if [ "$remaining_messages" -eq 0 ]; then
    if _fzfllm_has_new_schema; then
      _fzfllm_execute_query "
      DELETE FROM threads WHERE id = '${cid}';
      DELETE FROM conversations WHERE id = '${cid}';"
    else
      _fzfllm_execute_query "DELETE FROM conversations WHERE id = '${cid}';"
    fi
    return
  fi
  echo edit_thread_messages "$cid"
}

_fzfllm_open_stdin_in_editor() {
  _fzflib_open_stdin_in_editor "fzfllm_cid_${1}"
}

_fzfllm_new_thread() {
  local COMMAND MODEL TEMPLATE TEMPLATE_PARAMS param_value
  MODEL=$(llm models | fzf --delimiter ':\s|\s\(' --accept-nth '{2}' --tac)
  TEMPLATE=$(fzf --accept-nth '{1}' --delimiter '\s+:\s' --cycle   < <(echo 'none' && COLUMNS=$COLUMNS llm templates ))
  TEMPLATE_PARAMS=''
  if [ "$TEMPLATE" = 'none' ]; then
    TEMPLATE=''
  else
    for param in $(llm templates show "$TEMPLATE" | grep -o '\$[a-zA-Z_]\+' | sort | uniq | sed 's/\$//g'); do
      while [[ -z "$param_value" ]]; do
        read -e -r -p "Value of template parameter '$param': " param_value
      done
      TEMPLATE_PARAMS+="-p $param $param_value "
      param_value=''
    done
  fi
  COMMAND="llm chat -m $MODEL ${TEMPLATE:+-t }${TEMPLATE} ${TEMPLATE_PARAMS}"

  read -e -r -i "$COMMAND" -p "Start new thread with command?: " NEWCOMMAND
  $NEWCOMMAND > /dev/tty
}

_fzfllm_continue_thread() {
  llm chat --cid "$1" > /dev/tty
}

_fzfllm_rename_thread() {
  local CID="$1"
  shift
  read -e -r -i "$*" -p "Rename: " NEW_NAME
  if [ -z "$NEW_NAME" ]; then
    read -r -p "Aborted."
    return
  fi
   local ESCAPED_NAME="${NEW_NAME//\'/\'\'}"
   local UPDATE_QUERY="UPDATE conversations SET name='$ESCAPED_NAME' WHERE id='$CID'"
  _fzfllm_execute_query "$UPDATE_QUERY"
}

_fzfllm_clean_fragments() {
  local OPTS="
  $FZF_DEFAULT_OPTS
  $FZFLLM_FZF_GENERAL_OPTS
  --accept-nth={1}
  $FZFLLM_CLEAN_FRAGMENTS_FZF_OPTS"
  FRAGMENT_ID=$(_fzfllm_execute_query "SELECT id, source FROM fragments" | FZF_DEFAULT_OPTS="$OPTS" fzf)
  if [ -z "$FRAGMENT_ID" ]; then
    return
  fi
  if _fzfllm_has_new_schema; then
    # Since 0.32 new-schema fragments are referenced by turn_fragments
    # (provenance) and part_fragments (text_ref content), not the legacy
    # prompt/system_fragments tables. Note: deleting a fragment breaks
    # text_ref resolution in stored messages that borrowed its content -
    # that is the point of cleaning, and llm logs renders such parts as
    # missing text.
    _fzfllm_execute_query "
    DELETE FROM turn_fragments WHERE fragment_id = $FRAGMENT_ID;
    DELETE FROM part_fragments WHERE fragment_id = $FRAGMENT_ID;
    DELETE FROM prompt_fragments WHERE fragment_id = $FRAGMENT_ID;
    DELETE FROM system_fragments WHERE fragment_id = $FRAGMENT_ID;
    DELETE FROM fragment_aliases WHERE fragment_id = $FRAGMENT_ID;
    DELETE FROM fragments WHERE id = $FRAGMENT_ID;"
  else
    _fzfllm_execute_query "
    DELETE FROM prompt_fragments WHERE fragment_id = $FRAGMENT_ID;
    DELETE FROM system_fragments WHERE fragment_id = $FRAGMENT_ID;
    DELETE FROM fragment_aliases WHERE fragment_id = $FRAGMENT_ID;
    DELETE FROM fragments WHERE id = $FRAGMENT_ID;"
  fi
}

_fzfllm_help() {
  local HELP_TEXT
  HELP_TEXT="$(_bwhite "⌨  Keys:")
  $(_bgreen "$KEY_NEW_THREAD"): start a NEW THREAD.
  $(_bgreen "${KEY_RENAME_THREAD}"): RENAME the current thread.
  $(_bgreen "${KEY_EDIT_THREAD_MESSAGES}"): EDIT THE MESSAGES of the current thread.
  $(_bgreen "$KEY_OPEN_IN_PAGER"): OPEN IN PAGER the currently selected thread.
  $(_bgreen "$KEY_OPEN_IN_EDITOR"): OPEN IN EDITOR the currently selected thread.
  $(_bgreen "$KEY_CONTINUE_THREAD"): CONTINUE the currently selected thread.
  $(_bgreen "$KEY_DELETE"): DELETE the currently select entry.
  $(_bgreen "$KEY_SEARCH_THREADS"): SEARCH chats matching the current query (sqlite fts5 in prompts and responses).

  $(_bgreen "${KEY_TOGGLE_HEADER}"): toggles the header help (the one showing the \"$HEADER_TEXT\" text)
  $(_bgreen "$KEY_CHANGE_PREVIEW_PRESET"): toggles between the two preview layout presets.
  $(_bgreen "$KEY_PREVIEW_DOWN_1", "$KEY_PREVIEW_DOWN_2"): scrolls the preview down.
  $(_bgreen "$KEY_PREVIEW_UP_1", "$KEY_PREVIEW_UP_2"): scrolls the preview up.
  $(_bgreen "$KEY_PAGE_UP", "$KEY_PAGE_DOWN"): scrolls the preview by a full page.

  $(_bgreen "$KEY_CLEAN_FRAGMENTS"): Cleans fragments (useful for llm-docs plugin)

  Other default fzf mappings apply, like the following:
  $(_white "ctrl-c Esc ctrl-q"): to quit
  $(_white "ctrl-j ctrl-n down"): to go down
  $(_white "ctrl-k ctrl-p up"): to go up

  Keys can be freely changed but only via env vars for now, read the source code to see how :)
  "
  echo "$HELP_TEXT"
}

# Since 0.32 llm logs new data to content-addressed tables (threads, turns,
# turn_search, ...) and the legacy tables are read-only history. `llm logs
# path` does not migrate a database, so ensure the new tables exist before
# querying them (migrate() runs on `llm logs status`). If they are still
# absent the installed llm predates 0.32, and the caller falls back to
# querying the legacy tables only.
_fzfllm_ensure_migrated() {
  if [ -z "${LLM_FZFLLM_MIGRATED:-}" ]; then
    LLM_FZFLLM_MIGRATED=1
    LLM_FZFLLM_NEW_SCHEMA=
    local DB
    DB=$(llm logs path)
    if [ -z "$(sqlite3 "$DB" "SELECT name FROM sqlite_master WHERE type='table' AND name='threads'")" ]; then
      llm logs status >/dev/null 2>&1 || true
    fi
    if [ -n "$(sqlite3 "$DB" "SELECT name FROM sqlite_master WHERE type='table' AND name='threads'")" ]; then
      LLM_FZFLLM_NEW_SCHEMA=1
    fi
  fi
}

_fzfllm_has_new_schema() {
  # The guard is idempotent; run it here too so the very first branch
  # decision is not made before the schema is detected.
  _fzfllm_ensure_migrated
  [ "${LLM_FZFLLM_NEW_SCHEMA:-}" = 1 ]
}

# sqlite3 seems to have a problem if we specify the separator as a NUL byte directly.
_fzfllm_execute_query() {
  _fzfllm_ensure_migrated
  local DB
  DB=$(llm logs path)
  sqlite3 -separator $'\x1F' -newline $'\x1E' "$DB" "$1" | tr $'\x1E' '\0'
}

# This subcommand parses the stdin which is assumed to be
# the output of `llm template show some_template`.
# It outputs a string like `-p param1 value1 -p param2 value2 -p param3 value3`
# where each value is the value taken from the defaults section or XXX.
# We print first the pairs that have a default.
function _fzfllm_extract_params_from_llm_template() {
  local stdinvalue
  stdinvalue=$(cat)
  declare -A defaults
  while read -r key value; do
    defaults[$key]=$value
  done < <(awk '/^defaults:/, /^[\^ ]/ { if($1 != "defaults:" && $1 != "") { gsub(":", ""); print $1, $2 } }' <<< "$stdinvalue")
  local dollar_words_in_stdin
  dollar_words_in_stdin=$(grep -o '\$[a-zA-Z0-9_]\+' <<< "$stdinvalue" | sort | uniq | sed 's/\$//g')
  while read -r param; do
    if [[ -n "${defaults[$param]}" ]]; then
      echo -n "-p $param ${defaults[$param]} "
    fi
  done <<< "$dollar_words_in_stdin"
  while read -r param; do
    if [[ -z "${defaults[$param]}" ]]; then
      echo -n "-p $param XXX "
    fi
  done <<< "$dollar_words_in_stdin"
}

cmd="${1:-main}"
shift

public_commands=(
  "main"
  "list_threads"
  "new_thread"
  "delete_thread"
  "delete_message"
  "open_stdin_in_editor"
  "search_threads"
  "continue_thread"
  "rename_thread"
  "edit_thread_messages"
  "preview_message"
  "help"
  "extract_params_from_llm_template"
  "clean_fragments"
  # "execute_query"
)

# shellcheck disable=SC2076
if [[ ! " ${public_commands[*]} " =~ " ${cmd} " ]] ; then
  echo Invalid command "$cmd" 1>&2
  sleep 1
  exit 1
fi

_fzfllm_"${cmd}" "$@"

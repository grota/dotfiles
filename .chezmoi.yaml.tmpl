encryption: gpg
{{- if lookPath "bat" }}
pager: bat
{{- else }}
pager: cat
{{- end }}
{{ $develmode := promptBool "Is devel mode? (false)" false -}}
{{- if $develmode -}}
sourceDir: {{ output "pwd" -}}
{{- end -}}
gpg:
  # key ID, not the name: "Giuseppe Rota" matches two keys in this keyring
  # (2021 drupal uid + 2022 github-anon uid) and gpg picks the wrong one.
  recipient: A2CF72B90ADE5E7C
{{- if (and (not (lookPath "bw")) (stat (joinPath .chezmoi.homeDir "local" "bin" "bw"))) }}
bitwarden:
  command: {{ .chezmoi.homeDir }}/local/bin/bw
{{ end }}

{{ $headless := promptBool "The system is headless? (false)" false -}}
data:
  headless: {{ $headless }}

hooks:
  re-add:
    pre:
      command: sh
      args:
        - -c
        # - /home/grota/.local/share/chezmoi/chezmoi_ignored/dconf/refresh-dconf-dump.sh && noctalia config export > ~/.config/noctalia/config.toml
        - 'case ":${XDG_CURRENT_DESKTOP}:" in *:GNOME:*) /home/grota/.local/share/chezmoi/chezmoi_ignored/dconf/refresh-dconf-dump.sh ;; esac'
